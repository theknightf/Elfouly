# QUIZ ARENA Environment Configuration Example

# Supabase Realtime & Database (Default Online Serverless Multiplayer)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY

# Optional: Dedicated Node/Socket.IO Server (Only needed if VITE_MULTIPLAYER_PROVIDER=socketio)
PORT=3001
VITE_SERVER_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separate multiple origins: https://app.example.com,https://admin.example.com
