    "test:roleguards": "tsx tests/roleGuardViews.test.ts",
    "test:supabase": "tsx tests/supabaseMultiplayer.test.ts",
    "test:supabase-authority": "tsx tests/supabaseAuthority.test.ts",
    "test:server-url": "tsx tests/serverUrlAndSession.test.ts",
    "test:lobby": "tsx tests/lobbyWaitingSystem.test.ts",
    "test:rooms": "tsx tests/roomSystem.test.ts",
    "test:r2": "tsx tests/round2Roles.test.ts",
    "test:integrity": "tsx tests/roundIntegrity.test.ts",
