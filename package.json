    "questions:validate": "node scripts/validate_question_bank.mjs",
    "questions:add": "node scripts/add_questions.mjs",
    "test:undef": "tsx tests/noUndefined.test.ts",
    "test:lobby-rooms": "tsx tests/lobbyRooms.test.ts",
    "test:onetime": "tsx tests/oneTimeQuestions.test.ts",
    "test:custom-character": "tsx tests/customCharacter.test.ts",
    "test:runtime": "tsx tests/serverRuntime.test.ts",
    "test:bank": "tsx tests/questionBank.test.ts",
    "test:auction": "tsx tests/auctionRules.test.ts",
    "test:powers": "tsx tests/powers.test.ts",
